@startuml Iterator Pattern - Book and BookShelf

skinparam classAttributeIconSize 0

interface Iterator {
  +hasNext(): boolean
  +next(): Object
}

class BookIterator {
  -books: Book[]
  -index: int
  +hasNext(): boolean
  +next(): Book
}

interface Aggregate {
  +iterator(): Iterator
}

class BookShelf {
  -books: Book[]
  -last: int
  +getBookAt(index: int): Book
  +appendBook(book: Book): void
  +getLength(): int
  +iterator(): Iterator
}

class Book {
  -title: String
  -author: String
  +getTitle(): String
  +getAuthor(): String
}

Iterator <|.. BookIterator : implements
Aggregate <|.. BookShelf : implements
BookShelf *-- Book : contains
BookShelf ..> Iterator : creates
BookIterator ..> Book : uses

note right of BookIterator
  Concrete Iterator
  Provides sequential access
  to books in the shelf
end note

note right of BookShelf
  Concrete Aggregate
  Stores books and creates
  iterator instances
end note

@enduml




